# Public, build-time settings. Restart Vite after changing them.
# API origin/prefix for the HTTP helper; /api uses the same origin.
# The app still uses in-memory mocks until api.ts endpoints are migrated.
VITE_API_BASE_URL=http://localhost:3000/api

# Freighter's expected network name (for example TESTNET, PUBLIC, or FUTURENET).
VITE_STELLAR_NETWORK=TESTNET
